[Unit]
Description=XDDP leased XDP controller (no automatic attachment)
After=network.target
RequiresMountsFor=/sys/fs/bpf
Requires=xddp-bpffs.service
After=xddp-bpffs.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
RuntimeDirectory=xddp
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/local/libexec/xddp-preflight
ExecStart=/usr/local/sbin/ddosctl --daemon
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
LimitMEMLOCK=infinity
LimitNOFILE=4096
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=no
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_RESOURCE
ReadWritePaths=/sys/fs/bpf/xddp /etc/xddp /run/xddp

[Install]
WantedBy=multi-user.target

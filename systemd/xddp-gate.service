[Unit]
Description=XDDP Minecraft admission gate
Wants=network-online.target
After=network-online.target xddp-controller.service

[Service]
Type=simple
User=xddp
Group=xddp
ExecStartPre=/usr/local/bin/xddp-gate /etc/xddp/gate.json --check
ExecStart=/usr/local/bin/xddp-gate /etc/xddp/gate.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=75
LimitNOFILE=524288
TasksMax=128
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target

{
  "interface": "eth0",
  "xdp_mode": "driver",
  "pin_dir": "/sys/fs/bpf/xddp/v1",
  "object": "/usr/local/lib/xddp/xdp_ddos.bpf.o",
  "loader": "/usr/local/libexec/xddp-loader",
  "socket": "/run/xddp/control.sock",
  "runtime_file": "/run/xddp/runtime.json",
  "metrics_file": "/run/xddp/xdp.prom",
  "gate_metrics": "http://127.0.0.1:9109/metrics",
  "observe": true,
  "manual_mode": "auto",
  "lease_seconds": 10,
  "ipv6": false,
  "drop_tcp_fragments": false,
  "owned_prefixes": [],
  "protected_tcp_ports": [
    25565
  ],
  "drop_tcp_ports": [],
  "drop_udp_ports": [],
  "allow_prefixes": [],
  "block_prefixes": [],
  "bogon_prefixes": [],
  "syn_per_cpu": {
    "normal": {
      "rate": 1024,
      "burst": 2048
    },
    "elevated": {
      "rate": 512,
      "burst": 1024
    },
    "attack": {
      "rate": 128,
      "burst": 512
    },
    "emergency": {
      "rate": 128,
      "burst": 512
    }
  },
  "adaptive": {
    "allow_emergency": false,
    "required_signals": {},
    "up_samples": 3,
    "down_samples": 30,
    "cooldown_seconds": 60,
    "thresholds": {
      "elevated": {
        "conntrack_percent": {
          "enter": 60,
          "exit": 40
        },
        "conntrack_projected_percent": {
          "enter": 60,
          "exit": 40
        }
      },
      "attack": {
        "conntrack_percent": {
          "enter": 80,
          "exit": 55
        },
        "conntrack_projected_percent": {
          "enter": 85,
          "exit": 60
        },
        "conntrack_drops_per_second": {
          "enter": 1,
          "exit": 0
        },
        "listen_overflows_per_second": {
          "enter": 1,
          "exit": 0
        }
      },
      "emergency": {}
    },
    "up_cooldown_seconds": 0,
    "immediate_signals": {
      "attack": [
        "conntrack_drops_per_second",
        "listen_overflows_per_second"
      ]
    }
  }
}
